# Copy to .env for local Node + Docker Compose.

# App
PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=imperial-local
SESSION_SECRET=imperial-local-session-secret-change-me

# Postgres (used by docker compose + local vite against host port)
POSTGRES_DB=imperial
POSTGRES_USER=imperial
POSTGRES_PASSWORD=imperial
POSTGRES_PORT=5432
DATABASE_URL=postgresql://imperial:imperial@localhost:5432/imperial
